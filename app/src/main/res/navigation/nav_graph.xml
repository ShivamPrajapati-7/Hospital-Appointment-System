<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/choiseDoctorFragment">
    <fragment
        android:id="@+id/choiseDoctorFragment"
        android:name="com.shivaminteractive.hospital_appointment_system.ChoiseDoctorFragment"
        android:label="fragment_choise_doctor"
        tools:layout="@layout/fragment_choise_doctor" >
        <action
            android:id="@+id/action_choiseDoctorFragment_to_appointment_schedule_Fragment"
            app:destination="@id/appointment_schedule_Fragment" />
    </fragment>
    <fragment
        android:id="@+id/appointment_schedule_Fragment"
        android:name="com.shivaminteractive.hospital_appointment_system.appointment_schedule_Fragment"
        android:label="fragment_appointment_schedule_"
        tools:layout="@layout/fragment_appointment_schedule_" >
        <action
            android:id="@+id/action_appointment_schedule_Fragment_to_patient_dashboard_activity"
            app:destination="@id/patient_dashboard_activity" />
    </fragment>
    <activity
        android:id="@+id/patient_dashboard_activity"
        android:name="com.shivaminteractive.hospital_appointment_system.patient_dashboard_activity"
        android:label="patient_dashboard_activity" />
</navigation>