<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Patient Details"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#172554"
            android:layout_marginBottom="18dp"/>

        <!-- Patient Profile -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patient Information"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"/>

                <TextView
                    android:id="@+id/tvPatientName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:textSize="16sp"
                    android:textColor="#172554"
                    android:layout_marginTop="15dp"/>

                <TextView
                    android:id="@+id/tvPatientAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Age"
                    android:textSize="15sp"
                    android:textColor="#444444"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvPatientGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gender"
                    android:textSize="15sp"
                    android:textColor="#444444"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvPatientPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phone"
                    android:textSize="15sp"
                    android:textColor="#444444"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvNextAppointment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Appointment Time"
                    android:textSize="15sp"
                    android:textColor="#444444"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvBloodGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Blood Group"
                    android:textSize="15sp"
                    android:textColor="#444444"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Address"
                    android:textSize="15sp"
                    android:textColor="#444444"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- Medical History -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medical History"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"/>

                <TextView
                    android:id="@+id/tvAllergies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Allergies: None"
                    android:textColor="#444444"
                    android:layout_marginTop="15dp"/>

                <TextView
                    android:id="@+id/tvCondition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Existing Conditions: None"
                    android:textColor="#444444"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvMedication"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Current Medication: None"
                    android:textColor="#444444"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- Medical Reports -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medical Reports"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View patient's uploaded reports"
                    android:textSize="13sp"
                    android:textColor="#777777"
                    android:layout_marginTop="5dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/reportsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/tvNoReports"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No medical reports uploaded yet."
                    android:textColor="#777777"
                    android:gravity="center"
                    android:padding="15dp"
                    android:visibility="gone"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
