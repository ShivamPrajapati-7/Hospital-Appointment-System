<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/Patient_Registration_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">



            <EditText
                android:id="@+id/patient_Full_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"
                android:background="@drawable/login_area"
                android:drawableStart="@drawable/person"
                android:drawablePadding="16dp"
                android:ems="10"
                android:hint="Full Name"
                android:inputType="textEmailAddress"
                android:padding="15dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/patient_Date_Of_Birth"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:background="@drawable/login_area"
                    android:drawableStart="@drawable/envelop"
                    android:drawablePadding="16dp"
                    android:ems="10"
                    android:inputType="date"
                    android:padding="15dp"
                    android:layout_marginRight="20dp"/>
                <RadioGroup
                    android:id="@+id/patient_gender_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/Male"
                        android:text="M"
                        android:layout_marginRight="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <RadioButton
                        android:id="@+id/Female"
                        android:text="F"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </RadioGroup>


            </LinearLayout>


            <EditText
                android:id="@+id/email_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"
                android:background="@drawable/login_area"
                android:drawableStart="@drawable/envelop"
                android:drawablePadding="16dp"
                android:ems="10"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="15dp" />



                <Spinner
                    android:id="@+id/BloodGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:background="@drawable/login_area"
                    android:layout_marginBottom="20dp"
                    android:entries="@array/blood_groups"/>



            <EditText
                android:id="@+id/patient_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"
                android:background="@drawable/login_area"
                android:drawableStart="@drawable/phone"
                android:drawablePadding="16dp"
                android:ems="10"
                android:hint="Phone Number"
                android:inputType="phone"
                android:padding="15dp" />

            <EditText
                android:id="@+id/patient_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"
                android:background="@drawable/login_area"
                android:drawableStart="@drawable/lock"
                android:drawablePadding="16dp"
                android:ems="10"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="15dp" />


            <EditText
                android:id="@+id/patient_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="30dp"
                android:background="@drawable/login_area"
                android:drawableStart="@drawable/lock"
                android:drawablePadding="16dp"
                android:ems="10"
                android:hint="Confirm Password"
                android:inputType="textPassword"
                android:padding="15dp" />

            <CheckBox
                android:id="@+id/concent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14dp"
                android:text="I agree the term and conditions and policies" />

            <androidx.appcompat.widget.AppCompatButton

                android:id="@+id/btnpatientregistation"
                android:layout_width="200dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/register"
                android:backgroundTint="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="Register"
                android:textAllCaps="false"
                android:textColor="#1565C0"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>




</FrameLayout>
